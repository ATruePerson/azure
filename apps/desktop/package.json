{
  "name": "@azure/desktop",
  "version": "0.0.32",
  "private": true,
  "description": "Azure desktop build",
  "author": "ATruePerson",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@azure/client-runtime": "workspace:*",
    "@azure/contracts": "workspace:*",
    "@azure/shared": "workspace:*",
    "@azure/ssh": "workspace:*",
    "@azure/tailscale": "workspace:*",
    "@clerk/electron": "catalog:",
    "@clerk/electron-passkeys": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "electron": "41.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "playwright-core": "1.60.0",
    "react-grab": "^0.1.32"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "electron-builder": "26.15.6",
    "tailwindcss": "^4.0.0",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "com.atrueperson.azurecode",
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools"
    }
  },
  "productName": "Azure"
}
